              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{mobile}}\",\n  \"mode\": \"mobile\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-otp"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get(\"allowLiveActions\") !== \"true\") pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const cookie = pm.cookies.get(\"callanchor_portal_session\");",
                  "if (cookie) pm.environment.set(\"sessionCookie\", cookie);"
                ]
              }
            }
          ]
        }
