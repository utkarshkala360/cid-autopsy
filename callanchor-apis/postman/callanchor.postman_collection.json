  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "sendOtp",
          "request": {
            "method": "POST",
            "description": "Place an OTP call to a portal user. Safety: auth.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{mobile}}\",\n  \"mode\": \"mobile\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "send-otp"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get(\"allowLiveActions\") !== \"true\") pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "verifyOtp",
          "request": {
            "method": "POST",
            "description": "Exchange an OTP for a portal session. Safety: auth.",
            "header": [
              {
                "key": "Content-Type",
