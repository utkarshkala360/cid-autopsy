{
  "name": "cid-autopsy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm ci --prefix sf-cli --omit=dev --no-audit --no-fund",
    "sf": "node sf-cli/node_modules/@salesforce/cli/bin/run.js",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
