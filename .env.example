# Postgres connection string. Added automatically when you connect a Neon database
# to the Vercel project (Storage → Neon). Locally, copy it from Vercel.
DATABASE_URL=

# Random secret for signing session cookies (min 32 chars).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Admin console credentials.
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- '<password>'
ADMIN_PASSWORD_HASH=
